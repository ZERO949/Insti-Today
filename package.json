{
  "name": "insti-today",
  "version": "0.1.5",
  "private": true,
  "description": "Tus pendientes de Moodle (Plataforma UII) en el escritorio de Windows, Mac y Linux. Basado en BB Today.",
  "type": "module",
  "bin": {
    "insti-today-mcp": "src/servidor.js"
  },
  "scripts": {
    "start": "node src/servidor.js",
    "login": "node src/login.js",
    "probar": "node src/probar.js",
    "widget": "electron .",
    "empaquetar": "node tools/empaquetar-mcp.mjs && electron-builder --win --publish never",
    "publicar": "node tools/empaquetar-mcp.mjs && electron-builder --win --publish always",
    "mcp": "node tools/empaquetar-mcp.mjs",
    "moodle-falso": "node tools/moodle-falso.mjs",
    "probar-moodle": "node tools/probar-moodle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.9",
    "katex": "^0.19.0",
    "koffi": "^3.3.2",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.0"
  },
  "main": "widget/main.js",
  "productName": "Insti Today",
  "author": "Alvaro Uriel Perez Martinez (basado en BB Today de Ironmistyfox)",
  "homepage": "https://plataforma.uii.edu.mx/moodle",
  "build": {
    "appId": "mx.institoday.app",
    "productName": "Insti Today",
    "copyright": "© 2026 Alvaro Uriel Perez Martinez · basado en BB Today © 2026 Ironmistyfox (MIT)",
    "directories": {
      "output": "dist",
      "buildResources": "widget/icono"
    },
    "files": [
      "package.json",
      "widget/**/*",
      "!widget/icono/original.webp",
      "src/agenda.js",
      "src/cliente.js",
      "src/red.js",
      "src/datos.js",
      "src/detalle.js",
      "src/sesion.js",
      "src/contenido.js",
      "src/mensajes.js",
      "src/aprendizaje.js",
      "src/mantenimiento.js",
      "!node_modules/pdfjs-dist/legacy/**",
      "node_modules/pdfjs-dist/legacy/build/pdf.mjs",
      "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/@napi-rs/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "widget/mcp/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "widget/icono/icono.ico",
      "artifactName": "Insti-Today-Setup.${ext}"
    },
    "nsisWeb": {
      "artifactName": "Insti-Today-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Insti Today",
      "installerIcon": "widget/icono/icono.ico",
      "uninstallerIcon": "widget/icono/icono.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZERO949",
        "repo": "Insti-Today",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "compression": "maximum",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "widget/icono/icono-mac.png",
      "category": "public.app-category.productivity",
      "artifactName": "Insti-Today-Mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "Insti Today",
      "artifactName": "Insti-Today-Mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "widget/icono/icono.png",
      "category": "Office",
      "executableName": "insti-today",
      "synopsis": "Tus pendientes de Moodle en el escritorio",
      "description": "Widget de escritorio que reúne tareas, exámenes, mensajes y avisos de Moodle.",
      "maintainer": "Alvaro Uriel Perez Martinez"
    },
    "appImage": {
      "artifactName": "Insti-Today-Linux.${ext}"
    },
    "deb": {
      "artifactName": "Insti-Today-Linux.${ext}"
    }
  },
  "license": "MIT"
}
